DATABASE_URL=sqlite:///./sharora.db
# Prod example: postgresql+psycopg://sharora:<password>@localhost:5432/sharora

# Required, at least 32 characters: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Set to true behind HTTPS
COOKIE_SECURE=false

CORS_ORIGINS=http://localhost:3000

MEDIA_DIR=./media
MEDIA_URL=/media
MAX_UPLOAD_MB=10

# First admin, created on first API start or seed.py. Password: required, at least 8 characters.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=
