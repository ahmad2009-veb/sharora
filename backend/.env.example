DATABASE_URL=sqlite:///./sharora.db
# Prod example: postgresql+psycopg://sharora:<password>@localhost:5432/sharora

# Required, at least 32 characters: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Set to true behind HTTPS
COOKIE_SECURE=false

CORS_ORIGINS=http://localhost:3000

MEDIA_DIR=./media
MEDIA_URL=/media
MAX_UPLOAD_MB=10

# First admin, created on first API start (not on Vercel) or by seed.py.
# Password: at least 8 characters; not needed by the running API on Vercel.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=

# Vercel Blob read-write token. Empty = uploads are saved to MEDIA_DIR (local dev / Docker).
# On Vercel it is added automatically when you connect a Blob store; keep MAX_UPLOAD_MB=4
# there (Vercel Functions accept request bodies up to 4.5 MB).
BLOB_READ_WRITE_TOKEN=
