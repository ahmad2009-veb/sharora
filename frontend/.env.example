# Where Next.js proxies /api and /media (used at build time by rewrites).
BACKEND_URL=http://localhost:8000
# Leave empty to go through the proxy (recommended: admin cookie stays first-party).
# Set e.g. https://api.sharora.tj to call FastAPI directly (then add the site to CORS_ORIGINS).
NEXT_PUBLIC_API_URL=
# Canonical URL for metadata, Open Graph and sitemap.xml
NEXT_PUBLIC_SITE_URL=https://sharora.tj
