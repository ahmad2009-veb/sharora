# Local/Docker only: where Next.js proxies /api and /media. Not used on Vercel
# (vercel.json routes those paths to the backend service).
BACKEND_URL=http://localhost:8000
# Leave empty (also on Vercel): the browser calls same-origin /api.
# Set e.g. https://api.zarafshon.tj to call FastAPI directly (then add the site to CORS_ORIGINS).
NEXT_PUBLIC_API_URL=
# Canonical URL for metadata, Open Graph and sitemap.xml
NEXT_PUBLIC_SITE_URL=https://zarafshon.tj
